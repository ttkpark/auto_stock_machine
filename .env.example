# =============================================
# [사용 방법]
# 이 파일을 복사하여 '.env' 로 이름을 바꾼 뒤,
# 아래 각 항목에 실제 발급받은 키를 채워 넣으세요.
# .env 파일은 절대 GitHub에 올리지 마세요!
# =============================================

# -----------------------------------------------
# 한국투자증권 KIS Developers API
# 발급처: https://apiportal.koreainvestment.com
# -----------------------------------------------

# 모의투자 (테스트용)
KIS_MOCK_APP_KEY=여기에_모의투자_앱키를_입력하세요
KIS_MOCK_APP_SECRET=여기에_모의투자_앱시크릿을_입력하세요
KIS_MOCK_ACCOUNT_NUMBER=여기에_모의투자_계좌번호를_입력하세요

# 실전투자 (실제 돈이 움직임 - 신중하게!)
KIS_REAL_APP_KEY=여기에_실전투자_앱키를_입력하세요
KIS_REAL_APP_SECRET=여기에_실전투자_앱시크릿을_입력하세요
KIS_REAL_ACCOUNT_NUMBER=여기에_실전투자_계좌번호를_입력하세요

# -----------------------------------------------
# Anthropic Claude (API 키 불필요 — 로컬 claude CLI 구독 로그인 사용)
# 설치: npm install -g @anthropic-ai/claude-code  &&  claude login
#   (봇을 실행하는 동일한 OS 사용자로 로그인해야 합니다)
# -----------------------------------------------
# claude CLI 분석기 사용 여부 (true/false, 기본 true)
CLAUDE_CLI_ENABLED=true
# CLI 모델 별칭 (sonnet/haiku/opus, 기본 sonnet)
CLAUDE_CLI_MODEL=sonnet
# (선택) claude 실행 파일 경로. PATH에 있으면 비워두세요.
# CLAUDE_CLI_PATH=
# (선택) 호출 타임아웃 초 (기본 120)
# CLAUDE_CLI_TIMEOUT=120

# -----------------------------------------------
# Google Gemini API (2번째 독립 판단기 — 경량 모델)
# 발급처: https://aistudio.google.com/app/apikey
# -----------------------------------------------
GEMINI_API_KEY=여기에_Gemini_API_키를_입력하세요
GEMINI_MODEL_NAME=gemini-2.0-flash-lite

# -----------------------------------------------
# 매수 합의 기준: 서로 다른 판단기 중 몇 개가 같은 종목을 추천해야 매수할지
# 기본 2 = Claude(CLI) + Gemini 둘 다 동의(과반수)해야 진행
# -----------------------------------------------
MIN_AI_CONSENSUS=2

# -----------------------------------------------
# Telegram Bot
# 발급처: 텔레그램에서 @BotFather 에게 /newbot
# -----------------------------------------------
TELEGRAM_BOT_TOKEN=여기에_텔레그램_봇_토큰을_입력하세요
# 선택: 기본 수신자 1명을 고정하고 싶을 때만 입력
# (권장) 봇에 start/end 문자를 보내 구독/해지 자동 관리
TELEGRAM_CHAT_ID=

# -----------------------------------------------
# 시스템 설정
# -----------------------------------------------
# True = 실전투자 (실제 계좌), False = 모의투자 (가상 계좌)
IS_REAL_TRADING=False
# 앱/스케줄 기준 타임존 (권장: Asia/Seoul)
APP_TIMEZONE=Asia/Seoul

# -----------------------------------------------
# 웹 환경변수 관리자 (선택)
# -----------------------------------------------
# web_admin.py 로그인 비밀번호 (필수)
WEB_ADMIN_PASSWORD=여기에_웹관리자_비밀번호를_입력하세요
# 세션 시크릿(선택, 비워두면 매 실행 시 랜덤 생성)
WEB_ADMIN_SESSION_SECRET=
